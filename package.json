{
  "name": "srinivasa-silks",
  "version": "1.0.0",
  "description": "Srinivasa Silks E-Commerce Store & Hyderabad Delivery Management",
  "type": "module",
  "scripts": {
    "dev:server": "cd server && npm run dev",
