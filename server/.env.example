# Srinivasa Silks Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Optional: Defaults to built-in JSON database if not specified)
# Options: 'postgres' | 'mysql' | 'json'
DB_TYPE=json

# If using PostgreSQL:
# DB_TYPE=postgres
# DATABASE_URL=postgresql://username:password@localhost:5432/srinivasa_silks

# If using MySQL:
# DB_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=srinivasa_silks
